[gd_scene format=3]

[node name="HUD" type="CanvasLayer"]
script = "res://scripts/hud.gd"

[node name="MarginContainer" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0

[node name="TopRow" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 24

[node name="ScoreLabel" type="Label" parent="MarginContainer/VBoxContainer/TopRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "SCORE: 0"

[node name="HighScoreLabel" type="Label" parent="MarginContainer/VBoxContainer/TopRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "HI: 0"

[node name="LivesLabel" type="Label" parent="MarginContainer/VBoxContainer/TopRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "LIVES: 3"

[node name="WaveLabel" type="Label" parent="MarginContainer/VBoxContainer/TopRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 10
theme_override_font_sizes/font_size = 20
text = "WAVE: 1"

[node name="WeaponLevelLabel" type="Label" parent="MarginContainer/VBoxContainer/TopRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "LVL: 1"

[node name="PauseOverlay" type="Control" parent="MarginContainer"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="ColorRect" type="ColorRect" parent="MarginContainer/PauseOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.05, 0.08, 0.85)

[node name="PauseLabel" type="Label" parent="MarginContainer/PauseOverlay"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -80.0
offset_top = -160.0
offset_right = 80.0
offset_bottom = -120.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 48
text = "PAUSED"
horizontal_alignment = 1
vertical_alignment = 1

[node name="PauseMenu" type="VBoxContainer" parent="MarginContainer/PauseOverlay"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -120.0
offset_top = -80.0
offset_right = 120.0
offset_bottom = 80.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
alignment = 1

[node name="ResumeButton" type="Button" parent="MarginContainer/PauseOverlay/PauseMenu"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "RESUME"

[node name="RestartButton" type="Button" parent="MarginContainer/PauseOverlay/PauseMenu"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "RESTART"

[node name="QuitButton" type="Button" parent="MarginContainer/PauseOverlay/PauseMenu"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "QUIT"
