[gd_scene format=3]

[node name="Leaderboard" type="Control"]
layout_mode = 3
anchors_preset = 0

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
color = Color(0, 0, 0, 1)

[node name="Center" type="VBoxContainer" parent="."]
layout_mode = 1
offset_left = -250.0
offset_top = -260.0
offset_right = 250.0
offset_bottom = 260.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 42
text = "LEADERBOARD"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Spacer" type="Control" parent="Center"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="List" type="VBoxContainer" parent="Center/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8
alignment = 1

[node name="EmptyLabel" type="Label" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "No scores yet. Go hunt some stars!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Spacer2" type="Control" parent="Center"]
layout_mode = 2

[node name="BackBtn" type="Button" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "BACK    返回"
