; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DotAgent Dev Sandbox"
config/description="Development sandbox for DotAgent Banyan multi-agent plugin"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

TaskRunner="*res://addons/dotagent/legacy_agent/task_runner.gd"

[display]

window/size/viewport_width=1280.0
window/size/viewport_height=720.0
window/stretch/mode="\"canvas_items\""
window/stretch/aspect="\"keep\""

[editor_plugins]

enabled=PackedStringArray("res://addons/dotagent/plugin.cfg")

[run]

main_scene="res://scenes/main.tscn"
